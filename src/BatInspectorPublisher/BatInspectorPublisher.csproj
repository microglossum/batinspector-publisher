<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 stays so consumers on .NET 8 can use the package; net10.0 is the current LTS. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>BatInspectorPublisher</RootNamespace>
    <AssemblyName>BatInspectorPublisher</AssemblyName>

    <PackageId>BatInspectorPublisher</PackageId>
    <!-- Version comes from the git tag (MinVer): tag v0.1.0 gives package 0.1.0, tag v0.2.0-preview.1 gives 0.2.0-preview.1. Untagged builds are the next patch as a preview, 0.1.1-preview.0.N. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
    <Authors>Simon Köhler</Authors>
    <Copyright>Copyright (c) 2026 Simon Köhler</Copyright>
    <Description>Publishes bat acoustic-monitoring observations from BatInspector to citizen-science platforms (iNaturalist first).</Description>
    <PackageTags>bats;bioacoustics;inaturalist;citizen-science;batinspector</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/microglossum/batinspector-publisher/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/microglossum/batinspector-publisher</RepositoryUrl>
    <PackageProjectUrl>https://github.com/microglossum/batinspector-publisher</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- After pack: net8.0 and net10.0 must expose the same API. The baseline check against an earlier release waits for a stable version. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="BatInspectorPublisher.Tests" />
    <!-- The manual smoke test host exercises the silent token renewal, which is internal. Never part of the release package. -->
    <InternalsVisibleTo Include="SmokeTest" Condition="'$(Configuration)' != 'Release'" />
  </ItemGroup>

</Project>
