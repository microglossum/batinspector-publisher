{
  "dotnet.defaultSolution": "BatInspectorPublisher.sln",
  "editor.formatOnSave": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/bin": true,
    "**/obj": true
  },
  "files.watcherExclude": {
    "**/bin/**": true,
    "**/obj/**": true
  },
  "search.exclude": {
    "**/bin": true,
    "**/obj": true,
    "local": true
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  }
}
